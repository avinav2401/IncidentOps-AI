# Copy this file to .env for local Docker Compose overrides.
# Do not commit real credentials or production secrets.

# Public service ports
FRONTEND_PORT=3000
BACKEND_PORT=8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Demo application settings
APP_ENV=development
DEMO_MODE=true
JWT_SECRET_KEY=replace-with-a-long-random-secret-before-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:3000

# Optional local persistence for the seeded/demo backend
INCIDENTOPS_DATA_FILE=/app/data/incidentops.json

# Local PostgreSQL (used by the Compose infrastructure service)
POSTGRES_DB=incidentops
POSTGRES_USER=incidentops
POSTGRES_PASSWORD=incidentops_dev_password

# Opt-in integrations. Leave blank to keep safe demo/mock behavior.
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CHANNEL=
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
PAGERDUTY_WEBHOOK_SECRET=
